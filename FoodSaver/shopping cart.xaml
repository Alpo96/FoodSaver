<Window x:Class="FoodSaver.shopping_cart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoodSaver"
        mc:Ignorable="d"
        Title="shopping_cart" Height="450" Width="760" Closing="Window_Closing">
    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="Images/flowerwalpaper_1280.png" Stretch="UniformToFill"/>
            </Grid.Background>
        </Grid>
        <StackPanel Height="420" Width="900" Grid.Row="0" VerticalAlignment="Top" Margin="0,0,0,0">
            <DataGrid x:Name="DTGrid" AutoGenerateColumns="False" Height="349" Margin="160,10" Width="580" Background="Transparent" CanUserAddRows="False" SelectionUnit="FullRow" VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style x:Key="CenterText" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Location" Header="Location" Width="100" CanUserResize="False" ElementStyle="{StaticResource CenterText}" CanUserReorder="False" Binding="{Binding Path=Location}"/>
                    <DataGridTextColumn x:Name="Quality" Header="Quality" Width="*" MinWidth="20" CanUserResize="False" ElementStyle="{StaticResource CenterText}" CanUserReorder="False" Binding="{Binding Path=QualityPercent}"/>
                    <DataGridTextColumn x:Name="Name" Header="Name" Width="*" MinWidth="20" CanUserResize="False" ElementStyle="{StaticResource CenterText}" CanUserReorder="False" Binding="{Binding Path=Name}"/>
                    <DataGridTextColumn x:Name="FoodValue" Header="Value" Width="*" MinWidth="20" CanUserResize="False" ElementStyle="{StaticResource CenterText}" CanUserReorder="False" Binding="{Binding Path=FoodValueCoin}"/>
                    <DataGridTemplateColumn x:Name="ImagePath" Header="Image" Width="180" MinWidth="20" CanUserResize="False" CanUserReorder="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Path=ImagePath}" Width="100" Height="100"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- <DataGridTextColumn x:Name="Id" Header="ID" Binding="{Binding Id}" Visibility="Hidden"/> -->
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
        <TextBox x:Name="SpentCoinText" HorizontalAlignment="Left" Height="21" Margin="29,116,0,0" TextWrapping="Wrap" Text="{Binding SpentCoin}" VerticalAlignment="Top" Width="100"/>
        <Label x:Name="tbTime" HorizontalAlignment="Left" Height="44" Margin="179,366,0,0" Foreground="Red" VerticalAlignment="Top" Width="541" FontSize="22"/>
        <Image Height="128" Width="120" Margin="10,-12,623.6,304" x:Name="Money" Source="Images/coinbroke_640.png"/>
        <Image x:Name="Cancel" Height="100" Width="100" Margin="29,137,624.6,183" Source="Images/cancelproductbuttonup_640.png" MouseLeftButtonDown="CancelProductButtonDown" MouseLeftButtonUp="Cancel_Order"/>
        <Image x:Name="CancelAll" Height="100" Width="100" Margin="29,237,624.6,83" Source="Images/cancelallbuttonup_640.png" MouseLeftButtonDown="CancelAllProductButtonDown" MouseLeftButtonUp="Cancel_AllOrder"/>
        <Image x:Name="DeleteAll" Height="100" Width="100" Margin="29,329,624.6,-9" Source="Images/deleteallbuttonup_640.png" MouseLeftButtonDown="DeleteAllProductButtonDown" MouseLeftButtonUp="DeleteAll_Order"/>
    </Grid>
</Window>
