<Window x:Class="FoodSaver.FistLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoodSaver"
        mc:Ignorable="d"
        Title="FistLogin"  Height="600" Width="600">
    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="Images/dockwallpaper_2560.png"/>
            </Grid.Background>
        </Grid>
        <TextBox x:Name="UserBox" HorizontalAlignment="Left" Height="23" Margin="218,177,0,0" TextWrapping="Wrap" Text="Please Enter a Username" VerticalAlignment="Top" Width="161" GotFocus="TextBox_GotFocus"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="218,222,0,0" VerticalAlignment="Top"  Width="161" Password="12345678910" GotFocus="PasswordBox_GotFocus" Height="23"/>
        <Image x:Name="LoginButton" Height="100" Width="100" Margin="459,424,34.6,46.4" Source="Images/signinbuttonup_640.png" MouseLeftButtonDown="LoginButtonDown" MouseLeftButtonUp="SearchLogin"/>
        <Image x:Name="RegisterButton" Height="100" Width="100" Margin="40,424,453.6,46.4" Source="Images/registrationbuttonup_640.png" MouseLeftButtonDown="RegisterButtonDown" MouseLeftButtonUp="Restistration"/>
    </Grid>
</Window>
